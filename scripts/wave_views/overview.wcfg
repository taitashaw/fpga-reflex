<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state>
   </wave_state>
   <db_ref_list>
      <db_ref path="tb_core.wdb" id="1">
         <top_modules>
            <top_module name="tb_core" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="55,000 ps"></ZoomStartTime>
      <ZoomEndTime time="760,055,000 ps"></ZoomEndTime>
      <Cursor1Time time="240,055,000 ps"></Cursor1Time>
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="230"></NameColumnWidth>
      <ValueColumnWidth column_width="90"></ValueColumnWidth>
   </column_width_setting>
   <WVObjectSize size="6" />
   <wave_markers>
      <marker label="burst" time="240055000" />
      <marker label="hidden" time="300055000" />
      <marker label="back" time="340055000" />
      <marker label="burst_end" time="440055000" />
   </wave_markers>
   <wvobject type="group" fp_name="group1">
      <obj_property name="label">gate</obj_property>
